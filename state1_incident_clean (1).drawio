        <mxCell id="s10" edge="1" parent="1" source="s4" style="html=1;endArrow=block;startArrow=none;strokeColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" target="s5" value="handle(): &quot;units on scene&quot;">
          <mxGeometry relative="1" x="0.1111" y="38" as="geometry">

        <mxCell id="s8" edge="1" parent="1" source="s2" style="html=1;endArrow=block;startArrow=none;strokeColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" target="s3" value="new ReportedState() via Facade.reportIncident()">
          <mxGeometry relative="1" x="0.0911" y="59" as="geometry">
